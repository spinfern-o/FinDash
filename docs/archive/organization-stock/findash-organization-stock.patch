new file mode 100644
index 0000000000000000000000000000000000000000..1d937989f666660975062e1eee755eaf0c287c21
--- /dev/null
+++ b/backend/api/briefing.js
@@ -0,0 +1,196 @@
+/**
+ * POST /api/briefing
+ *
+ * Turns a run of monthly figures into what to do next: opportunities, risks,
+ * and a short list of actions.
+ *
+ * UNLIKE /api/map-columns, this one does receive figures. Column matching
+ * only ever sees header text; advice cannot be given without the numbers.
+ * That is a real change in what leaves the browser, so the page only calls
+ * this when the reader presses the button: never on load, never on upload.
+ *
+ * Even so it takes only the per-month TOTALS the dashboard already shows:
+ * revenue, the four cost group totals, net profit, budget. No line items, no
+ * suppliers, no names. Nothing is stored here; the figures exist for the one
+ * request.
+ *
+ * Request:  { "months": [{ month, revenue, directExpenses, operatingExpenses,
+ *                          variableOverhead, fixedOverhead, totalExpenses,
+ *                          netProfit, budget }],
+ *             "currency": "USD" }        (optional ISO 4217 code)
+ * Response: { "opportunities": [...], "risks": [...], "actions": [...] }
+ */
+
+import Anthropic from "@anthropic-ai/sdk";
+import { allowAiUse } from "../../lib/ai-access.js";
+
+const client = new Anthropic();
+
+const MAXIMUM_MONTHS = 36;
+
+/* Exactly the fields that are passed on to the model. Anything else is dropped. */
+const ALLOWED_FIELDS = [
+  "month", "revenue", "directExpenses", "operatingExpenses", "variableOverhead",
+  "fixedOverhead", "totalExpenses", "netProfit", "budget"
+];
+
+function wholeNumber(value) {
+  if (typeof value === "number" && Number.isFinite(value)) {
+    return Math.round(value);
+  }
+  return 0;
+}
+
+/* Keeps a list of short strings, so a long model reply cannot flood the page. */
+function shortStrings(value, maximumCount) {
+  if (!Array.isArray(value)) {
+    return [];
+  }
+  const kept = [];
+  for (const item of value) {
+    if (typeof item === "string" && item.trim()) {
+      kept.push(item.trim().slice(0, 400));
+    }
+  }
+  return kept.slice(0, maximumCount);
+}
+
+/* Each month rebuilt from the allowed fields rather than passed on as sent:
+   a caller cannot smuggle extra fields through by adding them to the body. */
+function cleanMonth(month) {
+  const row = {};
+  for (const field of ALLOWED_FIELDS) {
+    if (field === "month") {
+      row.month = String(month.month ?? "").slice(0, 40);
+    } else {
+      row[field] = wholeNumber(month[field]);
+    }
+  }
+  return row;
+}
+
+function buildPrompt(months, currencyCode) {
+  let unitsLine = "Every amount is in whole currency units.";
+  if (currencyCode) {
+    unitsLine = `Every amount is in whole ${currencyCode} units; write amounts in ${currencyCode}.`;
+  }
+
+  return `You are advising the owner of a small business on their own monthly figures.
+${unitsLine} Costs are grouped into four buckets:
+direct (traceable to a unit or job), operating (scales with volume but not
+per-unit), variable overhead (rises with activity, not proportionally), and
+fixed overhead (does not move with sales).
+
+"budget" is the planned ceiling for TOTAL EXPENSES that month - it is not a
+revenue target. Compare it against totalExpenses only. A month is over budget
+when totalExpenses exceeds budget; saying revenue "beat budget" is a category
+error and must not appear.
+
+Monthly figures:
+${JSON.stringify(months, null, 1)}
+
+Reply with JSON only - no prose, no code fences:
+{"opportunities": ["..."], "risks": ["..."], "actions": ["..."]}
+
+- opportunities: up to 3 things working in their favour, or worth pressing.
+- risks: up to 3 things that will cost them money if left alone.
+- actions: up to 4 concrete next steps, each starting with a verb.
+
+Rules: cite the actual figures and month names you were given. Say "labour rose
+18% while revenue fell 4%", not "costs appear elevated". Keep each item to one
+sentence. If the data does not support a point, leave it out rather than padding
+the list. You are not a licensed financial adviser - suggest operational steps,
+never investment or tax advice.`;
+}
+
+/* The JSON object in the model's reply, from the first "{" to the last "}":
+   { value }, or { error } saying what was wrong with the reply. */
+function jsonInReply(text) {
+  const start = text.indexOf("{");
+  const end = text.lastIndexOf("}");
+  if (start < 0 || end <= start) {
+    return { error: "model did not return JSON" };
+  }
+  try {
+    return { value: JSON.parse(text.slice(start, end + 1)) };
+  } catch {
+    return { error: "model returned malformed JSON" };
+  }
+}
+
+export default async function handler(req, res) {
+  if (req.method !== "POST") {
+    return res.status(405).json({ error: "POST only" });
+  }
+
+  const body = req.body ?? {};
+  const months = body.months;
+  if (!Array.isArray(months) || !months.length || months.length > MAXIMUM_MONTHS) {
+    return res.status(400).json({ error: `months must be 1-${MAXIMUM_MONTHS} entries` });
+  }
+
+  // The page shows amounts in the reader's chosen currency; advice written in
+  // dollars beside a dashboard in euros reads as a mistake. Three capital
+  // letters or nothing: free text never reaches the prompt.
+  let currencyCode = null;
+  if (typeof body.currency === "string" && /^[A-Z]{3}$/.test(body.currency)) {
+    currencyCode = body.currency;
+  }
+
+  // Only for a logged-in person within today's allowance (lib/ai-access.js).
+  if (!(await allowAiUse(req, res, "advice"))) {
+    return;
+  }
+
+  const prompt = buildPrompt(months.map(cleanMonth), currencyCode);
+
+  try {
+    const response = await client.beta.messages.create({
+      model: "claude-opus-5-5",
+      // Room for the model's thinking as well as the reply. 12 months of
+      // figures once overran a 2048 ceiling and was cut off mid-JSON; the
+      // server caps the list lengths anyway, so unused room costs nothing.
+      max_tokens: 16000,
+      // A safety classifier can decline a request; "default" runs a declined
+      // one again on the model Anthropic recommends for that case.
+      betas: ["server-side-fallback-2026-07-01"],
+      fallbacks: "default",
+      thinking: { type: "adaptive" },
+      output_config: { effort: "medium" },
+      messages: [{ role: "user", content: prompt }]
+    });
+
+    if (response.stop_reason === "refusal") {
+      console.error("[findash-error] briefing refused:", response.stop_details?.category ?? "unknown");
+      return res.status(422).json({ error: "advice couldn't be written for these figures" });
+    }
+
+    // Cut off is not the same as malformed: say which it is, or the next
+    // person debugging this chases a JSON bug that is really a length limit.
+    if (response.stop_reason === "max_tokens") {
+      console.error("[findash-error] briefing truncated: hit max_tokens");
+      return res.status(502).json({ error: "the briefing ran long and was cut off - try a shorter period" });
+    }
+
+    let text = "";
+    for (const block of response.content) {
+      if (block.type === "text") {
+        text += block.text;
+      }
+    }
+
+    const reply = jsonInReply(text);
+    if (reply.error) {
+      return res.status(502).json({ error: reply.error });
+    }
+
+    return res.status(200).json({
+      opportunities: shortStrings(reply.value.opportunities, 3),
+      risks: shortStrings(reply.value.risks, 3),
+      actions: shortStrings(reply.value.actions, 4)
+    });
+  } catch (error) {
+    console.error("[findash-error] briefing failed:", error);
+    return res.status(502).json({ error: "briefing unavailable" });
+  }
+}
diff --git a/backend/api/capabilities.js b/backend/api/capabilities.js
new file mode 100644
index 0000000000000000000000000000000000000000..59d57ce9347b8a1b04c67245ce2936e009a7a399
--- /dev/null
+++ b/backend/api/capabilities.js
@@ -0,0 +1,35 @@
+/**
+ * GET /api/capabilities
+ *
+ * Says which optional features are actually set up on this site, so the
+ * page can offer only what exists instead of showing a button that fails.
+ *
+ * Returns true or false for each, never the addresses or keys behind them.
+ * Knowing that a forecast service is set up tells an attacker nothing
+ * useful; knowing where it lives would.
+ */
+
+import { accountsAreSetUp } from "../../lib/supabase.js";
+
+export default function handler(req, res) {
+  if (req.method !== "GET") {
+    return res.status(405).json({ error: "GET only" });
+  }
+
+  // A minute of caching is plenty: the answer only changes when the site's
+  // settings change, which means a redeploy anyway.
+  res.setHeader("Cache-Control", "public, max-age=60");
+
+  // The features that call Claude need a key, and accounts too: they are
+  // only for logged-in people, so each person's daily use can be capped
+  // (lib/ai-access.js).
+  const hasAccounts = accountsAreSetUp();
+  const hasClaude = Boolean(process.env.ANTHROPIC_API_KEY) && hasAccounts;
+  return res.status(200).json({
+    briefing: hasClaude,
+    mapping: hasClaude,
+    photos: hasClaude,
+    accounts: hasAccounts,
+    forecast: Boolean(process.env.FORECAST_URL)
+  });
+}
diff --git a/backend/api/figures.js b/backend/api/figures.js
new file mode 100644
index 0000000000000000000000000000000000000000..4b738d976f283b29e32c6e1e607c1e68cbbb7409
--- /dev/null
+++ b/backend/api/figures.js
@@ -0,0 +1,133 @@
+/**
+ * /api/figures
+ *
+ * The logged-in owner's figures, saved in their account so they are there on
+ * any computer they log in on.
+ *
+ *   GET                -> { figures, updatedAt }   figures is null when nothing is saved
+ *   PUT  { figures }   -> { updatedAt }
+ *   DELETE             -> { ok: true }
+ *
+ * What is saved is what the dashboard keeps in the browser: the worked-out
+ * monthly totals and the invoice lines the owner confirmed. Never the
+ * spreadsheet itself, never a photo.
+ *
+ * Requests go to the database as the logged-in person (lib/supabase.js), and
+ * the table's row-level security (supabase/migrations/) only lets anyone
+ * reach their own row. This function could not read someone else's figures
+ * even if it tried.
+ */
+
+import { accountsAreSetUp, supabaseClient } from "../../lib/supabase.js";
+import { currentSession, isSameSite } from "../../lib/session.js";
+
+const TABLE = "account_figures";
+
+/* Far more than a business needs (50 years of months, thousands of
+   invoices), and small enough that no one can use this as free storage. */
+const MAXIMUM_BYTES = 1_000_000;
+const MAXIMUM_MONTHS = 600;
+const MAXIMUM_INVOICES = 5000;
+
+/* The table has not been created yet: the site's owner has not run the SQL
+   in supabase/migrations/. */
+function isMissingTable(error) {
+  return error.code === "42P01" || error.code === "PGRST205";
+}
+
+function storageFailed(res, error, message) {
+  console.error("[findash-error] figures:", error.code || "", error.message);
+  if (isMissingTable(error)) {
+    return res.status(503).json({ error: "saving to accounts isn't set up on this site yet" });
+  }
+  return res.status(502).json({ error: message });
+}
+
+/* A reason the figures cannot be saved, or "" when they are fine. Only the
+   shape and size are checked here; the dashboard checks every field again
+   when it loads them. */
+function problemWithFigures(figures) {
+  if (!figures || typeof figures !== "object" || Array.isArray(figures)) {
+    return "figures must be an object";
+  }
+  if (!Array.isArray(figures.months) || !Array.isArray(figures.invoices)) {
+    return "figures need a list of months and a list of invoices";
+  }
+  if (figures.months.length > MAXIMUM_MONTHS) {
+    return `at most ${MAXIMUM_MONTHS} months can be saved`;
+  }
+  if (figures.invoices.length > MAXIMUM_INVOICES) {
+    return `at most ${MAXIMUM_INVOICES} invoices can be saved`;
+  }
+  if (Buffer.byteLength(JSON.stringify(figures), "utf8") > MAXIMUM_BYTES) {
+    return "these figures are too large to save";
+  }
+  return "";
+}
+
+async function loadFigures(res, client) {
+  const { data, error } = await client.from(TABLE).select("figures, updated_at").maybeSingle();
+  if (error) {
+    return storageFailed(res, error, "Your saved figures couldn't be loaded right now.");
+  }
+  if (!data) {
+    return res.status(200).json({ figures: null, updatedAt: null });
+  }
+  return res.status(200).json({ figures: data.figures, updatedAt: data.updated_at });
+}
+
+async function saveFigures(res, client, user, body) {
+  const problem = problemWithFigures(body.figures);
+  if (problem) {
+    return res.status(400).json({ error: problem });
+  }
+  const updatedAt = new Date().toISOString();
+  const { error } = await client.from(TABLE).upsert({
+    user_id: user.id,
+    figures: body.figures,
+    updated_at: updatedAt
+  });
+  if (error) {
+    return storageFailed(res, error, "Your figures couldn't be saved to your account right now.");
+  }
+  return res.status(200).json({ updatedAt: updatedAt });
+}
+
+async function deleteFigures(res, client, user) {
+  const { error } = await client.from(TABLE).delete().eq("user_id", user.id);
+  if (error) {
+    return storageFailed(res, error, "Your figures couldn't be removed from your account right now.");
+  }
+  return res.status(200).json({ ok: true });
+}
+
+export default async function handler(req, res) {
+  res.setHeader("Cache-Control", "no-store");
+  if (!accountsAreSetUp()) {
+    return res.status(503).json({ error: "accounts aren't set up on this site yet" });
+  }
+  if (req.method !== "GET" && req.method !== "PUT" && req.method !== "DELETE") {
+    return res.status(405).json({ error: "GET, PUT or DELETE only" });
+  }
+  if (req.method !== "GET" && !isSameSite(req)) {
+    return res.status(403).json({ error: "request from another site" });
+  }
+
+  const session = await currentSession(req, res);
+  if (!session) {
+    return res.status(401).json({ error: "Log in to save your figures to your account." });
+  }
+  const client = supabaseClient(session.accessToken);
+
+  if (req.method === "GET") {
+    return loadFigures(res, client);
+  }
+  if (req.method === "PUT") {
+    let body = {};
+    if (req.body && typeof req.body === "object") {
+      body = req.body;
+    }
+    return saveFigures(res, client, session.user, body);
+  }
+  return deleteFigures(res, client, session.user);
+}
diff --git a/backend/api/forecast.js b/backend/api/forecast.js
new file mode 100644
index 0000000000000000000000000000000000000000..2c64f346928ddcaad3587558c6e3755e521540e7
--- /dev/null
+++ b/backend/api/forecast.js
@@ -0,0 +1,147 @@
+/**
+ * POST /api/forecast
+ *
+ * Passes a request on to the Chronos-Bolt service in forecast/. Kept behind
+ * this site's own address so the service's address and token never reach
+ * the browser.
+ *
+ * Like /api/briefing this receives figures rather than header text, so the
+ * page only calls it when the reader presses the button. It takes a bare
+ * list of numbers: no month names, no line items, no budget. Twelve numbers
+ * say nothing about whose business it is.
+ *
+ * Request:  { "series": [7580, 5420, -3640, ...], "horizon": 3 }
+ * Response: { "model": "...", "low": [...], "predicted": [...], "high": [...] }
+ *
+ * Answers 503 with a clear reason when FORECAST_URL is not set, so the page
+ * can keep its own trend line rather than show an error.
+ */
+
+const MAXIMUM_POINTS = 240;
+const MAXIMUM_HORIZON = 12;
+const TIMEOUT_MILLISECONDS = 50_000;
+
+function isFiniteNumber(value) {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+/* One of the three lists in the service's answer, as numbers. Null unless it
+   has exactly `horizon` entries and every one is a finite number.
+   Dropping the bad entries instead once turned a partly broken answer into a
+   plausible shorter forecast. */
+function numberList(value, horizon) {
+  if (!Array.isArray(value) || value.length !== horizon) {
+    return null;
+  }
+  const numbers = value.map(Number);
+  if (!numbers.every(Number.isFinite)) {
+    return null;
+  }
+  return numbers;
+}
+
+/* A range where low is above high is not a wide forecast, it is a broken one. */
+function isInOrder(low, predicted, high) {
+  for (let step = 0; step < low.length; step++) {
+    if (!(low[step] <= predicted[step] && predicted[step] <= high[step])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/* Asks the service, giving up after TIMEOUT_MILLISECONDS: the model is
+   small, but running it on a container that has just started is not instant. */
+async function askForecastService(baseUrl, series, horizon) {
+  const controller = new AbortController();
+  const timer = setTimeout(function () {
+    controller.abort();
+  }, TIMEOUT_MILLISECONDS);
+
+  try {
+    return await fetch(baseUrl.replace(/\/$/, "") + "/forecast", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        series: series.map(Number),
+        horizon: horizon,
+        token: process.env.FORECAST_TOKEN ?? ""
+      }),
+      signal: controller.signal
+    });
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export default async function handler(req, res) {
+  if (req.method !== "POST") {
+    return res.status(405).json({ error: "POST only" });
+  }
+
+  const serviceUrl = process.env.FORECAST_URL;
+  if (!serviceUrl) {
+    return res.status(503).json({
+      error: "no forecast service configured",
+      hint: "set FORECAST_URL to a deployment of forecast/main.py"
+    });
+  }
+
+  const body = req.body ?? {};
+  const series = body.series;
+  if (!Array.isArray(series) || !series.length || series.length > MAXIMUM_POINTS) {
+    return res.status(400).json({ error: `series must be 1-${MAXIMUM_POINTS} numbers` });
+  }
+  if (!series.every(isFiniteNumber)) {
+    return res.status(400).json({ error: "series must be finite numbers" });
+  }
+  let horizon = 3;
+  if (body.horizon !== undefined) {
+    horizon = Number(body.horizon);
+  }
+  if (!Number.isInteger(horizon) || horizon < 1 || horizon > MAXIMUM_HORIZON) {
+    return res.status(400).json({ error: `horizon must be 1-${MAXIMUM_HORIZON}` });
+  }
+
+  try {
+    const upstream = await askForecastService(serviceUrl, series, horizon);
+
+    if (!upstream.ok) {
+      console.error("[findash-error] forecast upstream:", upstream.status);
+      // A 503 is passed on rather than turned into a 502. The service answers
+      // 503 when it is up but the model cannot be loaded (no torch, no
+      // weights): "unavailable, keep the local trend", not "broken". Its
+      // detail can name a file path, so it is logged, not repeated.
+      if (upstream.status === 503) {
+        return res.status(503).json({ error: "forecast model not available" });
+      }
+      return res.status(502).json({ error: "forecast service returned " + upstream.status });
+    }
+
+    const answer = await upstream.json();
+    const low = numberList(answer.low, horizon);
+    const predicted = numberList(answer.predicted, horizon);
+    const high = numberList(answer.high, horizon);
+    if (!low || !predicted || !high) {
+      return res.status(502).json({ error: "forecast service returned an incomplete band" });
+    }
+    if (!isInOrder(low, predicted, high)) {
+      return res.status(502).json({ error: "forecast quantiles are out of order" });
+    }
+
+    return res.status(200).json({
+      model: String(answer.model ?? "chronos"),
+      horizon: horizon,
+      low: low,
+      predicted: predicted,
+      high: high
+    });
+  } catch (error) {
+    // Never repeat the upstream error: it can carry the service's address.
+    console.error("[findash-error] forecast failed:", error);
+    if (error?.name === "AbortError") {
+      return res.status(502).json({ error: "forecast timed out" });
+    }
+    return res.status(502).json({ error: "forecast unavailable" });
+  }
+}
diff --git a/backend/api/map-columns.js b/backend/api/map-columns.js
new file mode 100644
index 0000000000000000000000000000000000000000..ded5590718e8e9410836e285511645b53b59ca7a
--- /dev/null
+++ b/backend/api/map-columns.js
@@ -0,0 +1,224 @@
+/**
+ * POST /api/map-columns
+ *
+ * Matches spreadsheet column headers to FinDash's own field names.
+ *
+ * Only header TEXT is accepted and passed on, never a row of figures. The
+ * browser keeps the figures, does the arithmetic, and asks this function one
+ * question: which header means what. That keeps the request tiny whatever
+ * the size of the file, and keeps anyone's finances off this server.
+ *
+ * Request:  { "headers":   ["Month", "Cost of Goods", ...],
+ *             "fields":    ["month num", "cogs", ...],      fields no column matched
+ *             "unclaimed": ["Bank service charge", ...] }   columns that matched nothing
+ * Response: { "mapping": { "cogs": "Cost of Goods" },
+ *             "other":   { "Bank service charge": "operating" } }
+ *
+ * "other" puts each column that matched no field into the cost group it
+ * behaves like, so its money still reaches the totals instead of silently
+ * reading zero.
+ */
+
+import Anthropic from "@anthropic-ai/sdk";
+import { allowAiUse } from "../../lib/ai-access.js";
+
+const client = new Anthropic(); // reads ANTHROPIC_API_KEY from the environment
+
+// This function is public and needs no login: anyone who finds it can spend
+// credits through it. These limits bound the damage; a spending limit set in
+// the Anthropic console is the only hard stop.
+const MAXIMUM_HEADERS = 120;
+const MAXIMUM_FIELDS = 60;
+const MAXIMUM_LABEL_LENGTH = 200;
+
+/* The four cost groups an unmatched column can be put in. */
+const COST_GROUPS = ["direct", "operating", "variable", "fixed"];
+
+/* Sites allowed to call this. An empty list allows any. */
+const ALLOWED_HOSTS = [];
+
+function isAllowedOrigin(req) {
+  if (!ALLOWED_HOSTS.length) {
+    return true;
+  }
+  const origin = req.headers.origin || req.headers.referer || "";
+  return ALLOWED_HOSTS.some(function (host) {
+    return origin.includes(host);
+  });
+}
+
+function isListOfLabels(value, minimumLength, maximumLength) {
+  if (!Array.isArray(value) || value.length < minimumLength || value.length > maximumLength) {
+    return false;
+  }
+  return value.every(function (label) {
+    return typeof label === "string" && label.length <= MAXIMUM_LABEL_LENGTH;
+  });
+}
+
+function buildPrompt(headers, fields, unclaimedHeaders) {
+  let unclaimedList = "(none)";
+  if (unclaimedHeaders.length) {
+    unclaimedList = unclaimedHeaders.join(", ");
+  }
+
+  return `You are mapping spreadsheet column headers to canonical accounting fields.
+
+Canonical fields needing a column: ${fields.join(", ")}
+
+The file's headers, in order: ${headers.join(", ")}
+
+Reply with JSON only - no prose, no code fences - shaped like:
+{"mapping": {"cogs": "Cost of Goods", "labor": null},
+ "other":   {"Bank service charge": "operating"}}
+
+"mapping": one key per canonical field listed above, whose value is the header
+text it corresponds to, or null if no header fits.
+
+Columns still unspoken for: ${unclaimedList}
+
+"other": for each of those unspoken-for columns that is a real cost - and ONLY
+those - which of these four buckets it behaves like: direct (traceable to a unit or job),
+operating (scales with volume but not per-unit), variable (rises with activity,
+but not proportionally), fixed (does not move with sales). Omit a header that is
+not a cost, or that is a subtotal of other columns - counting a subtotal
+alongside its parts double-counts the money.
+
+Copy header text exactly as given.`;
+}
+
+/* The JSON object in the model's reply, from the first "{" to the last "}":
+   { value }, or { error } saying what was wrong with the reply. */
+function jsonInReply(text) {
+  const start = text.indexOf("{");
+  const end = text.lastIndexOf("}");
+  if (start < 0 || end <= start) {
+    return { error: "model did not return JSON" };
+  }
+  try {
+    return { value: JSON.parse(text.slice(start, end + 1)) };
+  } catch {
+    return { error: "model returned malformed JSON" };
+  }
+}
+
+/* Drops anything made up: every key must be a field that was asked about,
+   and every value a header that was actually sent. */
+function checkedMapping(reply, headers, fields) {
+  const mapping = {};
+  for (const [field, header] of Object.entries(reply.mapping ?? {})) {
+    if (!fields.includes(field) || header === null) {
+      continue;
+    }
+    if (typeof header === "string" && headers.includes(header)) {
+      mapping[field] = header;
+    }
+  }
+  return mapping;
+}
+
+/* The same care for the cost groups: a real header, a real group, and never
+   a column already matched to a field, or its money would count twice. */
+function checkedLeftovers(reply, headers, unclaimedHeaders, mapping) {
+  const matchedHeaders = new Set(Object.values(mapping));
+  const leftovers = {};
+  for (const [header, group] of Object.entries(reply.other ?? {})) {
+    if (!headers.includes(header) || matchedHeaders.has(header)) {
+      continue;
+    }
+    // When the caller said which columns are unmatched, keep to that list: a
+    // column it has already matched must never come back as a leftover.
+    if (unclaimedHeaders.length && !unclaimedHeaders.includes(header)) {
+      continue;
+    }
+    if (COST_GROUPS.includes(group)) {
+      leftovers[header] = group;
+    }
+  }
+  return leftovers;
+}
+
+export default async function handler(req, res) {
+  if (req.method !== "POST") {
+    return res.status(405).json({ error: "POST only" });
+  }
+  if (!isAllowedOrigin(req)) {
+    return res.status(403).json({ error: "origin not allowed" });
+  }
+
+  const body = req.body ?? {};
+  const headers = body.headers;
+  const fields = body.fields;
+
+  if (!isListOfLabels(headers, 1, MAXIMUM_HEADERS)) {
+    return res.status(400).json({ error: `headers must be 1-${MAXIMUM_HEADERS} strings` });
+  }
+  // fields can rightly be empty: every field can already be matched on the
+  // page while unknown cost columns still need a group. Refusing that made
+  // the page drop those columns, understating costs.
+  if (!isListOfLabels(fields, 0, MAXIMUM_FIELDS)) {
+    return res.status(400).json({ error: `fields must be 0-${MAXIMUM_FIELDS} strings` });
+  }
+
+  // Which headers are still free. Without this the model is asked to group
+  // columns the page has already matched, and answers for all of them.
+  let unclaimedHeaders = [];
+  if (Array.isArray(body.unclaimed)) {
+    unclaimedHeaders = body.unclaimed.filter(function (header) {
+      return typeof header === "string" && headers.includes(header);
+    });
+  }
+
+  // There must be SOMETHING to ask about: an unmatched field or an unmatched
+  // column. Neither on its own is required.
+  if (!fields.length && !unclaimedHeaders.length) {
+    return res.status(400).json({ error: "nothing to map: send unplaced fields or unclaimed headers" });
+  }
+
+  // Only for a logged-in person within today's allowance (lib/ai-access.js).
+  if (!(await allowAiUse(req, res, "columns"))) {
+    return;
+  }
+
+  try {
+    const response = await client.beta.messages.create({
+      model: "claude-opus-5-5",
+      // Room for the model's thinking as well as the small reply.
+      max_tokens: 16000,
+      // A safety classifier can decline a request; "default" runs a declined
+      // one again on the model Anthropic recommends for that case.
+      betas: ["server-side-fallback-2026-07-01"],
+      fallbacks: "default",
+      thinking: { type: "adaptive" },
+      // Matching names is a simple job: little thinking needed.
+      output_config: { effort: "low" },
+      messages: [{ role: "user", content: buildPrompt(headers, fields, unclaimedHeaders) }]
+    });
+
+    if (response.stop_reason === "refusal" || response.stop_reason === "max_tokens") {
+      console.error("[findash-error] map-columns stopped:", response.stop_reason);
+      return res.status(502).json({ error: "column mapping unavailable" });
+    }
+
+    let text = "";
+    for (const block of response.content) {
+      if (block.type === "text") {
+        text += block.text;
+      }
+    }
+
+    // Forgiving about code fences or stray words around the object.
+    const reply = jsonInReply(text);
+    if (reply.error) {
+      return res.status(502).json({ error: reply.error });
+    }
+
+    const mapping = checkedMapping(reply.value, headers, fields);
+    const other = checkedLeftovers(reply.value, headers, unclaimedHeaders, mapping);
+    return res.status(200).json({ mapping: mapping, other: other });
+  } catch (error) {
+    // Never repeat the upstream error word for word: it can carry request details.
+    console.error("[findash-error] map-columns failed:", error);
+    return res.status(502).json({ error: "column mapping unavailable" });
+  }
+}
diff --git a/backend/api/read-document.js b/backend/api/read-document.js
new file mode 100644
index 0000000000000000000000000000000000000000..9ca52365f47c009e00ddbdc15d41bb3a94ec95ab
--- /dev/null
+++ b/backend/api/read-document.js
@@ -0,0 +1,463 @@
+/**
+ * POST /api/read-document
+ *
+ * Reads a photo of a business document (a supplier invoice, a bill, a
+ * receipt) and returns its lines as structured data, each line given one of
+ * the dashboard's fourteen cost lines.
+ *
+ * Unlike a spreadsheet, which never leaves the browser, this sends the photo
+ * itself: reading a picture needs the model. The page says so before a photo
+ * is added, and nothing is stored here: the image exists for the one
+ * request. Nothing is added to anyone's figures either: the page shows the
+ * reading to the owner, who checks it and decides.
+ *
+ * Request:  { "image": "<base64 JPEG/PNG/WebP/GIF>", "mediaType": "image/jpeg",
+ *             "language": "zh-CN",
+ *             "review": { "previous": {...}, "problems": ["..."] } }   (language/review optional)
+ * Response: { "document": {...}, "checks": {...}, "model": "..." }
+ *
+ * "review" is the second look. When a first reading fails its own arithmetic
+ * (the lines do not add up to the printed total, or a line's quantity times
+ * price is not its amount), the page sends the photo again with that reading
+ * and what failed, and the model reads the lines it got wrong again. A
+ * separate request rather than a loop in here, so each look gets its own
+ * time limit.
+ */
+
+import Anthropic from "@anthropic-ai/sdk";
+import { allowAiUse } from "../../lib/ai-access.js";
+
+const client = new Anthropic();
+
+// Public and needs no login, like the other functions: these limits bound
+// what one request can cost. A spending limit in the Anthropic console is the
+// hard stop. Vercel refuses request bodies over 4.5 MB before this code runs;
+// the page shrinks photos well under that.
+const MAXIMUM_BASE64_LENGTH = 6_000_000;
+const MEDIA_TYPES = ["image/jpeg", "image/png", "image/webp", "image/gif"];
+const DOCUMENT_KINDS = ["purchase", "sale", "other"];
+
+/* The dashboard's cost lines, named as data/expenses.csv names them. */
+const CATEGORIES = [
+  "cogs", "labor", "employee meals", "tax",
+  "packaging", "credit card fees", "marketing", "hardware",
+  "utilities", "maintenance",
+  "rent", "insurance", "business license", "telephone"
+];
+
+/* A schema that also allows null. */
+function nullable(schema) {
+  return { anyOf: [schema, { type: "null" }] };
+}
+
+/* Every field required, nulls allowed: structured outputs then guarantee the
+   shape, and "not on the document" is an explicit null rather than a guess. */
+const SCHEMA = {
+  type: "object",
+  additionalProperties: false,
+  required: ["kind", "legible", "supplier", "customer", "document_number", "date",
+             "currency", "lines", "subtotal_printed", "total_printed", "notes"],
+  properties: {
+    kind: { type: "string", enum: ["purchase", "sale", "other"] },
+    legible: { type: "boolean" },
+    supplier: nullable({ type: "string" }),
+    customer: nullable({ type: "string" }),
+    document_number: nullable({ type: "string" }),
+    date: nullable({ type: "string", format: "date" }),
+    currency: nullable({ type: "string" }),
+    lines: {
+      type: "array",
+      items: {
+        type: "object",
+        additionalProperties: false,
+        required: ["description", "original", "code", "quantity", "unit", "billed_quantity",
+                   "unit_price", "amount", "amount_source", "category"],
+        properties: {
+          description: { type: "string" },
+          original: nullable({ type: "string" }),
+          code: nullable({ type: "string" }),
+          quantity: nullable({ type: "number" }),
+          unit: nullable({ type: "string" }),
+          billed_quantity: nullable({ type: "number" }),
+          unit_price: nullable({ type: "number" }),
+          amount: { type: "number" },
+          amount_source: { type: "string", enum: ["printed", "computed"] },
+          category: { type: "string", enum: CATEGORIES }
+        }
+      }
+    },
+    subtotal_printed: nullable({ type: "number" }),
+    total_printed: nullable({ type: "number" }),
+    notes: { type: "array", items: { type: "string" } }
+  }
+};
+
+const SYSTEM = `You read photos of documents for FinDash, a monthly finance dashboard for small
+business owners, and return what the document says as structured data. The owner sees your
+reading before anything is saved, so accuracy matters more than completeness: copy what is
+printed, and never invent a figure.
+
+What kind of document it is:
+- "purchase": an invoice, bill or receipt for something the business bought.
+- "sale": a receipt, till report or statement of money the business took in.
+- "other": anything else. Set legible to false when the photo is not a readable financial
+  document at all (blurred, cropped past use, not a document).
+
+The lines. One entry per charged item, in the order printed:
+- description: the item in English. Many invoices print a name in another language and an
+  English description on the same row; use the English one, and put the other-language name,
+  exactly as printed, in "original". If there is no English, translate briefly and keep the
+  printed text in "original".
+- code: the supplier's item code or product number for the line (such as 00660A), exactly as
+  printed, or null when the line has none.
+- quantity and unit: the count as printed (3 cases, 10 lb, 5 bags).
+- billed_quantity: the number the unit price is multiplied by to give the amount. On food
+  invoices that is often a weight (meat priced per lb) while produce on the same invoice is
+  priced per case. Work out which from the figures, so billed_quantity x unit_price = amount.
+- unit_price and amount: copy them exactly as printed; do not round unit prices.
+- amount_source: "printed" when you read the amount off the page. When it is cut off, faded,
+  covered or creased past reading, work it out from billed_quantity x unit_price and say
+  "computed".
+- A row under an item that holds only that item's code and a few numbers (the weights of
+  individual cases or pieces, for example) belongs to the item above it. It is not a line.
+- Free or complimentary items (amount 0, often marked free, N/C or 送) are lines with amount 0.
+- Delivery fees, fuel surcharges, deposits and sales tax that are added to the total are lines
+  too, so the lines add up to the total. Discounts and credits are negative amounts.
+- Handwritten marks (check numbers, initials, ticks, references) are not charges. Mention them
+  in notes.
+
+category: the one cost line each charge belongs to.
+- cogs: anything sold or used to make what is sold: food, drink, meat, seafood, produce, eggs,
+  dry goods, rice, flour, cooking oil, sauces, vinegar, spices, stock bought for resale.
+- packaging: takeout containers, bags, cups, lids, wrap, foil, takeaway napkins and cutlery.
+- hardware: equipment, appliances, utensils, tools, electronics, furniture.
+- maintenance: repairs, servicing, cleaning supplies and services, pest control.
+- utilities: electricity, gas, water, waste collection.
+- telephone: phone and internet.
+- marketing: advertising, printing, promotions, listings.
+- credit card fees: card processing and payment fees.
+- rent: rent and other property occupancy charges.
+- insurance: insurance premiums.
+- business license: licences, permits, inspection fees.
+- labor: wages, payroll services, staffing agencies, contractors who work shifts.
+- employee meals: food bought for staff to eat.
+- tax: payroll tax only. Never use it for sales tax: sales tax, delivery fees and surcharges on
+  a purchase take the category of the goods they are charged on.
+
+The rest:
+- date: the document's date as YYYY-MM-DD (2026/9/26 is 2026-09-26). If day and month could be
+  either way round, use the supplier's country to decide and say so in notes.
+- supplier is who issued the document; customer is who it is billed to.
+- currency: the ISO code if the document shows it (a symbol, or the supplier's country makes
+  it plain), otherwise null.
+- subtotal_printed and total_printed: as printed, null if not shown or not readable.
+- notes: anything the owner should know - unreadable parts, handwritten marks, your doubts.
+
+Before you answer, add up your line amounts and compare the sum with the printed total, and
+check each line's billed_quantity x unit_price against its amount. If something does not
+match, look at the photo again: a misread digit or a continuation row read as its own line
+is the usual cause. If it still does not match, keep what is printed and explain in notes.`;
+
+const AMOUNT_TOLERANCE = 0.015;   // a cent and a half, for rounding on the paper
+
+/* Chinese stock review keeps the source text beside the translated label.
+   Existing finance imports continue to request English unless opted in. */
+function instructionsForLanguage(language) {
+  if (language !== "zh-CN") {
+    return SYSTEM;
+  }
+  return SYSTEM.replace(
+    '- description: the item in English. Many invoices print a name in another language and an\n' +
+    '  English description on the same row; use the English one, and put the other-language name,\n' +
+    '  exactly as printed, in "original". If there is no English, translate briefly and keep the\n' +
+    '  printed text in "original".',
+    '- description: a brief Simplified Chinese translation of the item, for a Chinese-speaking\n' +
+    '  owner to review. original: the exact printed item description, in its source language,\n' +
+    '  even when that source is English or Chinese. Never translate or paraphrase original.\n' +
+    '  Preserve quantities, printed units and supplier codes without conversion. Write notes\n' +
+    '  in Simplified Chinese too. Do not infer shelf stock from an invoice purchase quantity.'
+  );
+}
+
+function roundToCents(amount) {
+  return Math.round(amount * 100) / 100;
+}
+
+function isFiniteNumber(value) {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+function numberOrNull(value) {
+  if (isFiniteNumber(value)) {
+    return value;
+  }
+  return null;
+}
+
+/* Trimmed text no longer than maximumLength, or null when there is none. */
+function textOrNull(value, maximumLength) {
+  if (typeof value === "string" && value.trim()) {
+    return value.trim().slice(0, maximumLength);
+  }
+  return null;
+}
+
+/* Whether a line's quantity times its unit price gives its amount. Returns
+   null when it adds up (or cannot be checked), otherwise what it should be.
+   Either quantity may be the one the price applies to: invoices bill some
+   lines by weight and others by count. */
+function expectedAmountIfWrong(line) {
+  if (!isFiniteNumber(line.unit_price)) {
+    return null;
+  }
+  const quantities = [line.billed_quantity, line.quantity].filter(isFiniteNumber);
+  if (!quantities.length) {
+    return null;
+  }
+  const addsUp = quantities.some(function (quantity) {
+    return Math.abs(roundToCents(quantity * line.unit_price) - line.amount) <= AMOUNT_TOLERANCE;
+  });
+  if (addsUp) {
+    return null;
+  }
+  return { quantity: quantities[0], expected: roundToCents(quantities[0] * line.unit_price) };
+}
+
+/* Checks the model's arithmetic again here, where it cannot be talked out of. */
+export function checkDocument(doc) {
+  const problems = [];
+  const lineIssues = [];
+
+  doc.lines.forEach(function (line, index) {
+    const wrong = expectedAmountIfWrong(line);
+    if (wrong) {
+      lineIssues.push({ index: index, expected: wrong.expected });
+      problems.push(`Line ${index + 1} ("${line.description}"): ${wrong.quantity} x ${line.unit_price} = ` +
+        `${wrong.expected}, but the amount read is ${line.amount}.`);
+    }
+  });
+
+  let linesTotal = 0;
+  for (const line of doc.lines) {
+    linesTotal += line.amount;
+  }
+  const lineSum = roundToCents(linesTotal);
+
+  let total = null;
+  let difference = null;
+  if (isFiniteNumber(doc.total_printed)) {
+    total = doc.total_printed;
+    difference = roundToCents(lineSum - total);
+  }
+  if (difference !== null && Math.abs(difference) > AMOUNT_TOLERANCE) {
+    problems.push(`The lines add up to ${lineSum.toFixed(2)} but the printed total is ` +
+      `${total.toFixed(2)} (a difference of ${difference.toFixed(2)}).`);
+  }
+
+  const computedLines = doc.lines.filter(function (line) {
+    return line.amount_source === "computed";
+  }).length;
+
+  return {
+    ok: problems.length === 0,
+    lineSum: lineSum,
+    total: total,
+    difference: difference,
+    totalReadable: total !== null,
+    lineIssues: lineIssues,
+    problems: problems,
+    computedLines: computedLines
+  };
+}
+
+function normaliseLine(line) {
+  let amountSource = "printed";
+  if (line.amount_source === "computed") {
+    amountSource = "computed";
+  }
+  let category = "cogs";
+  if (CATEGORIES.includes(line.category)) {
+    category = line.category;
+  }
+  return {
+    description: textOrNull(line.description, 160) || "Item",
+    original: textOrNull(line.original, 160),
+    code: textOrNull(line.code, 40),
+    quantity: numberOrNull(line.quantity),
+    unit: textOrNull(line.unit, 40),
+    billed_quantity: numberOrNull(line.billed_quantity),
+    unit_price: numberOrNull(line.unit_price),
+    amount: roundToCents(line.amount),
+    amount_source: amountSource,
+    category: category
+  };
+}
+
+function centsOrNull(value) {
+  if (isFiniteNumber(value)) {
+    return roundToCents(value);
+  }
+  return null;
+}
+
+/* The model's reply matches the schema, but it is still model output: it is
+   rebuilt field by field so nothing unexpected reaches the page. */
+export function normalise(raw) {
+  let lines = [];
+  if (Array.isArray(raw.lines)) {
+    lines = raw.lines
+      .filter(function (line) {
+        return line && isFiniteNumber(line.amount);
+      })
+      .slice(0, 200)
+      .map(normaliseLine);
+  }
+
+  let date = null;
+  if (typeof raw.date === "string" && /^\d{4}-\d{2}-\d{2}$/.test(raw.date)) {
+    date = raw.date;
+  }
+  let currency = null;
+  if (typeof raw.currency === "string" && /^[A-Z]{3}$/.test(raw.currency)) {
+    currency = raw.currency;
+  }
+  let kind = "other";
+  if (DOCUMENT_KINDS.includes(raw.kind)) {
+    kind = raw.kind;
+  }
+
+  let notes = [];
+  if (Array.isArray(raw.notes)) {
+    notes = raw.notes
+      .map(function (note) {
+        return textOrNull(note, 300);
+      })
+      .filter(Boolean)
+      .slice(0, 12);
+  }
+
+  return {
+    kind: kind,
+    legible: raw.legible !== false,
+    supplier: textOrNull(raw.supplier, 120),
+    customer: textOrNull(raw.customer, 120),
+    document_number: textOrNull(raw.document_number, 60),
+    date: date,
+    currency: currency,
+    lines: lines,
+    subtotal_printed: centsOrNull(raw.subtotal_printed),
+    total_printed: centsOrNull(raw.total_printed),
+    notes: notes
+  };
+}
+
+function isValidImage(image) {
+  return typeof image === "string" && image.length > 0 && image.length <= MAXIMUM_BASE64_LENGTH &&
+    /^[A-Za-z0-9+/]+=*$/.test(image);
+}
+
+function isReviewRequest(review) {
+  return Boolean(review && typeof review === "object" && review.previous && Array.isArray(review.problems));
+}
+
+/* The words sent with the photo for a second look. The first reading comes
+   back from this function's own earlier answer, but it passes through the
+   browser, so it is rebuilt before it goes anywhere near the prompt. */
+function reviewInstructions(review) {
+  const previous = normalise(review.previous);
+  const problems = review.problems
+    .filter(function (problem) {
+      return typeof problem === "string";
+    })
+    .map(function (problem) {
+      return problem.slice(0, 300);
+    })
+    .slice(0, 20);
+
+  return "A first reading of this photo is below, but it fails these checks:\n- " +
+    problems.join("\n- ") +
+    "\n\nLook at the photo again, line by line, and return a corrected reading of the whole " +
+    "document. If the printed total itself cannot be read, say so in notes rather than " +
+    "forcing the lines to match it.\n\nFirst reading:\n" + JSON.stringify(previous);
+}
+
+export default async function handler(req, res) {
+  if (req.method !== "POST") {
+    return res.status(405).json({ error: "POST only" });
+  }
+
+  const body = req.body ?? {};
+  if (body.language !== undefined && body.language !== "en" && body.language !== "zh-CN") {
+    return res.status(400).json({ error: "language must be en or zh-CN" });
+  }
+  if (!isValidImage(body.image)) {
+    return res.status(400).json({ error: "image must be base64, under about 4 MB" });
+  }
+  if (!MEDIA_TYPES.includes(body.mediaType)) {
+    return res.status(400).json({ error: "mediaType must be one of " + MEDIA_TYPES.join(", ") });
+  }
+
+  // Only for a logged-in person within today's allowance (lib/ai-access.js).
+  if (!(await allowAiUse(req, res, "photo"))) {
+    return;
+  }
+
+  const content = [
+    { type: "image", source: { type: "base64", media_type: body.mediaType, data: body.image } }
+  ];
+  let effort = "medium";
+  if (isReviewRequest(body.review)) {
+    content.push({ type: "text", text: reviewInstructions(body.review) });
+    // The second look only happens when the first went wrong; it is worth
+    // the extra thinking.
+    effort = "high";
+  } else {
+    content.push({ type: "text", text: "Read this document." });
+  }
+
+  try {
+    const response = await client.beta.messages.create({
+      model: "claude-opus-5-5",
+      max_tokens: 16000,
+      // A safety classifier can decline a request; "default" runs a declined
+      // one again on the model Anthropic recommends for that case, instead of
+      // failing the owner's upload.
+      betas: ["server-side-fallback-2026-07-01"],
+      fallbacks: "default",
+      thinking: { type: "adaptive" },
+      output_config: { effort: effort, format: { type: "json_schema", schema: SCHEMA } },
+      system: instructionsForLanguage(body.language),
+      messages: [{ role: "user", content: content }]
+    });
+
+    if (response.stop_reason === "refusal") {
+      console.error("[findash-error] read-document refused:", response.stop_details?.category ?? "unknown");
+      return res.status(422).json({ error: "this photo could not be read" });
+    }
+    if (response.stop_reason === "max_tokens") {
+      console.error("[findash-error] read-document truncated: hit max_tokens");
+      return res.status(502).json({ error: "the document was too long to read in one go" });
+    }
+
+    let reply = "";
+    for (const block of response.content) {
+      if (block.type === "text") {
+        reply += block.text;
+      }
+    }
+
+    let raw;
+    try {
+      raw = JSON.parse(reply);
+    } catch {
+      return res.status(502).json({ error: "the reading came back malformed" });
+    }
+
+    const document = normalise(raw);
+    return res.status(200).json({ document: document, checks: checkDocument(document), model: response.model });
+  } catch (error) {
+    // Never repeat the upstream error word for word: it can carry request details.
+    console.error("[findash-error] read-document failed:", error);
+    return res.status(502).json({ error: "photo reading unavailable" });
+  }
+}
diff --git a/backend/api/report-error.js b/backend/api/report-error.js
new file mode 100644
index 0000000000000000000000000000000000000000..99077b2885a3e6c4d6df14d24015e61c4c7d4ead
--- /dev/null
+++ b/backend/api/report-error.js
@@ -0,0 +1,44 @@
+/**
+ * POST /api/report-error
+ *
+ * Errors that happen in a visitor's browser, written to this site's logs so
+ * whoever runs FinDash can see that something broke without waiting for an
+ * email. In Vercel: the project -> Logs, and search for "findash-error";
+ * every server-side failure is tagged the same way.
+ *
+ * Request: { "message": "...", "where": "dashboard.html:120", "page": "/dashboard" }
+ * Response: 204, always (a broken report must never cause another error).
+ *
+ * Nothing about the visitor's figures is sent: only the error message and
+ * where in the code it happened. Every field is cut short, so this cannot
+ * be used to fill the logs with large amounts of text.
+ */
+
+import { isSameSite } from "../../lib/session.js";
+
+const MAXIMUM_FIELD_LENGTH = 300;
+
+function shortText(value) {
+  if (typeof value !== "string") {
+    return "";
+  }
+  // One line, so a report cannot pretend to be several log entries.
+  return value.replace(/[\r\n]+/g, " ").slice(0, MAXIMUM_FIELD_LENGTH);
+}
+
+export default function handler(req, res) {
+  res.setHeader("Cache-Control", "no-store");
+  if (req.method !== "POST" || !isSameSite(req)) {
+    return res.status(204).end();
+  }
+
+  let body = {};
+  if (req.body && typeof req.body === "object") {
+    body = req.body;
+  }
+  const message = shortText(body.message);
+  if (message) {
+    console.error(`[findash-error] page ${shortText(body.page)}: ${message} (at ${shortText(body.where)})`);
+  }
+  return res.status(204).end();
+}
diff --git a/backend/api/waitlist.js b/backend/api/waitlist.js
new file mode 100644
index 0000000000000000000000000000000000000000..f59d32583cc26edc3d807b4be66d32c56393f6af
--- /dev/null
+++ b/backend/api/waitlist.js
@@ -0,0 +1,166 @@
+/**
+ * POST /api/waitlist
+ *
+ * Adds someone to the waitlist: their email, and a few answers about their
+ * business (what kind, where, which languages, how many supplier invoices a
+ * month), so FinDash can tell them when new features are ready and learn
+ * who it is for before building more.
+ *
+ * Request:  { email, businessType, country, ownerLanguages, staffLanguages,
+ *             invoiceLanguages, otherLanguages, invoicesPerMonth, hardestPart }
+ * Response: { ok: true }, or { error, field } naming the answer to fix.
+ *
+ * No login needed. The answers go to the waitlist table in Supabase, which
+ * anyone may add to but nobody can read through this site: only the site's
+ * owner, in the Supabase dashboard. The same email twice is kept once, and
+ * says so to no one: joining again simply answers "ok".
+ */
+
+import { accountsAreSetUp, supabaseClient } from "../../lib/supabase.js";
+import { BUSINESS_TYPES, LANGUAGES, LANGUAGE_GROUPS, INVOICE_COUNTS, TEXT_LIMITS } from "../../frontend/js/waitlist-options.js";
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function valuesOf(options) {
+  return options.map(function (option) {
+    return option.value;
+  });
+}
+
+/* Trimmed text, or "" when it isn't text. */
+function textOf(value) {
+  if (typeof value !== "string") {
+    return "";
+  }
+  return value.trim();
+}
+
+/* A list of known language codes, each once, or null when it isn't one. */
+function languageListOf(value) {
+  if (value === undefined) {
+    return [];
+  }
+  if (!Array.isArray(value)) {
+    return null;
+  }
+  const known = valuesOf(LANGUAGES);
+  const languages = [];
+  for (const code of value) {
+    if (!known.includes(code)) {
+      return null;
+    }
+    if (!languages.includes(code)) {
+      languages.push(code);
+    }
+  }
+  return languages;
+}
+
+/* The answers as a row for the waitlist table, or { error, field } for the
+   first one that can't be used. */
+function rowFromAnswers(answers) {
+  const email = textOf(answers.email).toLowerCase();
+  if (!EMAIL_PATTERN.test(email) || email.length > TEXT_LIMITS.email) {
+    return { error: "Enter a valid email address.", field: "email" };
+  }
+  if (!valuesOf(BUSINESS_TYPES).includes(answers.businessType)) {
+    return { error: "Choose what kind of business you run.", field: "businessType" };
+  }
+  const country = textOf(answers.country);
+  if (!country || country.length > TEXT_LIMITS.country) {
+    return { error: "Enter the country your business is in.", field: "country" };
+  }
+
+  const row = {
+    email: email,
+    business_type: answers.businessType,
+    country: country
+  };
+  const columns = { ownerLanguages: "owner_languages", staffLanguages: "staff_languages",
+    invoiceLanguages: "invoice_languages" };
+  for (const group of LANGUAGE_GROUPS) {
+    const languages = languageListOf(answers[group.key]);
+    if (languages === null) {
+      return { error: "Choose languages from the list, and add any others below it.", field: group.key };
+    }
+    row[columns[group.key]] = languages;
+  }
+
+  const otherLanguages = textOf(answers.otherLanguages);
+  if (otherLanguages.length > TEXT_LIMITS.otherLanguages) {
+    return { error: "Keep other languages to a short list.", field: "otherLanguages" };
+  }
+  row.other_languages = otherLanguages || null;
+
+  if (!valuesOf(INVOICE_COUNTS).includes(answers.invoicesPerMonth)) {
+    return { error: "Choose about how many supplier invoices you get a month.", field: "invoicesPerMonth" };
+  }
+  row.invoices_per_month = answers.invoicesPerMonth;
+
+  const hardestPart = textOf(answers.hardestPart);
+  if (hardestPart.length > TEXT_LIMITS.hardestPart) {
+    return { error: `Keep it under ${TEXT_LIMITS.hardestPart} characters.`, field: "hardestPart" };
+  }
+  row.hardest_part = hardestPart || null;
+  return row;
+}
+
+/* The waitlist table does not exist yet: the site's owner has not run the
+   SQL in supabase/migrations/. */
+function isMissingTable(error) {
+  return error.code === "42P01" || error.code === "PGRST205";
+}
+
+/* A browser always says which page a form was sent from. Answers sent from
+   another site, or by a script that doesn't say, are refused. */
+function isFromThisSite(req) {
+  const origin = req.headers.origin;
+  if (!origin) {
+    return false;
+  }
+  try {
+    return new URL(origin).host === req.headers.host;
+  } catch {
+    return false;
+  }
+}
+
+export default async function handler(req, res) {
+  res.setHeader("Cache-Control", "no-store");
+  if (req.method !== "POST") {
+    return res.status(405).json({ error: "POST only" });
+  }
+  if (!isFromThisSite(req)) {
+    return res.status(403).json({ error: "request from another site" });
+  }
+  if (!accountsAreSetUp()) {
+    return res.status(503).json({ error: "The waitlist isn't open on this site yet." });
+  }
+
+  let answers = {};
+  if (req.body && typeof req.body === "object" && !Array.isArray(req.body)) {
+    answers = req.body;
+  }
+
+  // A field people never see, which only form-filling robots fill in. They
+  // are told it worked, and nothing is kept.
+  if (textOf(answers.website)) {
+    return res.status(200).json({ ok: true });
+  }
+
+  const row = rowFromAnswers(answers);
+  if (row.error) {
+    return res.status(400).json(row);
+  }
+
+  const { error } = await supabaseClient().from("waitlist").insert(row);
+  // 23505: this email is on the list already. Nothing to add, nothing to say.
+  if (error && error.code !== "23505") {
+    console.error("[findash-error] waitlist:", error.code || "", error.message);
+    if (isMissingTable(error)) {
+      return res.status(503).json({ error: "The waitlist isn't open on this site yet." });
+    }
+    return res.status(502).json({ error: "Your answers couldn't be saved just now. Try again in a moment." });
+  }
+  return res.status(200).json({ ok: true });
+}
diff --git a/backend/inventory.js b/backend/inventory.js
new file mode 100644
index 0000000000000000000000000000000000000000..826980d0699bc50420028551efdcca946dc84e14
--- /dev/null
+++ b/backend/inventory.js
@@ -0,0 +1,104 @@
+/* The account's physical-stock ledger. Only confirmed text and counts are
+   saved; invoice images stay out of this table. RLS uses the owner's token.
+   PUT requires the revision last read, so two tabs cannot erase each other. */
+
+import { accountsAreSetUp, supabaseClient } from "../lib/supabase.js";
+import { currentSession, isSameSite } from "../lib/session.js";
+import { emptyInventory, validateInventory } from "../frontend/js/stock/ledger.js";
+
+const TABLE = "account_inventory";
+const MAXIMUM_BYTES = 1_000_000;
+
+/* Storage errors reveal setup or availability, never the owner's records. */
+function storageFailed(res, error) {
+  console.error("[findash-error] inventory:", error.code || "storage failure");
+  if (error.code === "42P01" || error.code === "PGRST205") {
+    return res.status(503).json({ error: "Inventory saving isn't set up on this site yet." });
+  }
+  return res.status(502).json({ error: "Inventory could not be saved or loaded right now." });
+}
+
+/* Read only this owner's row, using the database's row-level policies. */
+async function loadInventory(client, res) {
+  const { data, error } = await client.from(TABLE).select("inventory, revision").maybeSingle();
+  if (error) {
+    return storageFailed(res, error);
+  }
+  if (!data) {
+    return res.status(200).json({ inventory: emptyInventory(), revision: 0 });
+  }
+  try {
+    validateInventory(data.inventory);
+  } catch {
+    return res.status(502).json({ error: "Saved inventory could not be read. Your saved record has not been changed." });
+  }
+  return res.status(200).json({ inventory: data.inventory, revision: data.revision });
+}
+
+/* Compare-and-swap in one database write; never load then blindly overwrite. */
+async function saveInventory(client, user, body, res) {
+  if (!Number.isSafeInteger(body.revision) || body.revision < 0 || body.revision >= Number.MAX_SAFE_INTEGER) {
+    return res.status(400).json({ error: "Supply the inventory revision last read." });
+  }
+  try {
+    validateInventory(body.inventory);
+    if (Buffer.byteLength(JSON.stringify(body.inventory), "utf8") > MAXIMUM_BYTES) {
+      throw new Error("Inventory is too large to save.");
+    }
+  } catch (error) {
+    return res.status(400).json({ error: error.message });
+  }
+  const row = {
+    user_id: user.id,
+    inventory: body.inventory,
+    revision: body.revision + 1,
+    updated_at: new Date().toISOString()
+  };
+  let query;
+  if (body.revision === 0) {
+    query = client.from(TABLE).insert(row);
+  } else {
+    query = client.from(TABLE).update(row).eq("user_id", user.id).eq("revision", body.revision);
+  }
+  const { data, error } = await query.select("revision").maybeSingle();
+  if (error && error.code !== "23505") {
+    return storageFailed(res, error);
+  }
+  if (error || !data) {
+    return res.status(409).json({ error: "Inventory changed in another tab. Reload before saving again.", conflict: true });
+  }
+  return res.status(200).json({ revision: data.revision });
+}
+
+/* Authenticate every read and reject cross-site writes before touching data. */
+export default async function handler(req, res) {
+  res.setHeader("Cache-Control", "no-store");
+  if (req.method !== "GET" && req.method !== "PUT") {
+    return res.status(405).json({ error: "GET or PUT only" });
+  }
+  if (req.method === "PUT" && !isSameSite(req)) {
+    return res.status(403).json({ error: "request from another site" });
+  }
+  if (!accountsAreSetUp()) {
+    return res.status(503).json({ error: "Accounts aren't set up on this site yet." });
+  }
+  const session = await currentSession(req, res);
+  if (!session) {
+    return res.status(401).json({ error: "Log in to save inventory to your account." });
+  }
+  // Another tab can switch accounts while this page still holds the old
+  // owner's records. Bind reads and writes to the owner this page loaded.
+  const expectedOwner = req.headers["x-findash-owner"];
+  if (req.method === "PUT" && expectedOwner === undefined) {
+    return res.status(400).json({ error: "Supply the account owner loaded by this page." });
+  }
+  if (expectedOwner !== undefined && (typeof expectedOwner !== "string" ||
+      expectedOwner.toLowerCase() !== String(session.user.email).toLowerCase())) {
+    return res.status(401).json({ error: "The signed-in account changed. Export your work before reloading." });
+  }
+  const client = supabaseClient(session.accessToken);
+  if (req.method === "GET") {
+    return loadInventory(client, res);
+  }
+  return saveInventory(client, session.user, req.body || {}, res);
+}
