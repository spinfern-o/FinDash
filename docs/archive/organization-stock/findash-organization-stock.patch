diff --git a/frontend/js/stock/files.js b/frontend/js/stock/files.js
new file mode 100644
index 0000000000000000000000000000000000000000..09b8e7080a830675fd21f4bf27c27db9333f87cc
--- /dev/null
+++ b/frontend/js/stock/files.js
@@ -0,0 +1,133 @@
+/* Invoice readings are a temporary review queue. Nothing enters the stock
+   ledger until the owner confirms a physical shelf count. */
+import { preparePhotoForUpload } from '../dashboard/photos/photo-reader.js';
+import { currentLanguage } from './language.js';
+import { store } from './storage.js';
+export const drafts = [];
+const waiting = [];
+let readers = 0;
+let onChange = function () {};
+const MAXIMUM_ACTIVE_DRAFTS = 12;
+export function onFilesChanged(callback) { onChange = callback; }
+
+/* Bound the original files, compressed photos and review fields in memory. */
+function queueIsFull() {
+  return drafts.filter(function (draft) { return draft.status === 'reading' || draft.status === 'ready'; }).length >= MAXIMUM_ACTIVE_DRAFTS;
+}
+
+/* The content digest catches duplicate uploads even when filenames differ. */
+async function fingerprint(file) {
+  const digest = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
+  return Array.from(new Uint8Array(digest)).map(function (byte) { return byte.toString(16).padStart(2, '0'); }).join('');
+}
+function alreadyAdded(hash) {
+  return drafts.some(function (draft) { return draft.hash === hash; }) || store.inventory.movements.some(function (movement) {
+    return movement.note === 'source:' + hash;
+  });
+}
+
+/* At most two readings run together, independent of how long review takes. */
+export async function addFiles(files) {
+  for (const file of files) {
+    if (queueIsFull()) {
+      drafts.push({ id: crypto.randomUUID(), name: file.name, status: 'failed', error: 'queueFull' });
+      continue;
+    }
+    if (file.size > 20_000_000 || !/^image\/(jpeg|png|webp)$/.test(file.type)) {
+      drafts.push({ id: crypto.randomUUID(), name: file.name, status: 'failed', error: 'unsupported' });
+      continue;
+    }
+    let hash;
+    try {
+      hash = await fingerprint(file);
+    } catch {
+      drafts.push({ id: crypto.randomUUID(), name: file.name, status: 'failed', error: 'failed' });
+      continue;
+    }
+    if (alreadyAdded(hash)) {
+      drafts.push({ id: crypto.randomUUID(), name: file.name, status: 'failed', error: 'duplicate' });
+      continue;
+    }
+    // Another drop can finish hashing while this file is being read.
+    if (queueIsFull()) {
+      drafts.push({ id: crypto.randomUUID(), name: file.name, status: 'failed', error: 'queueFull' });
+      continue;
+    }
+    const draft = { id: crypto.randomUUID(), name: file.name, hash: hash, status: 'reading', file: file, language: currentLanguage() };
+    drafts.push(draft);
+    waiting.push(draft);
+    // Start accepted files immediately. A later file failing to read from
+    // disk must not strand earlier uploads in a queue that never runs.
+    onChange();
+    startWaiting();
+  }
+  onChange();
+  startWaiting();
+}
+function startWaiting() {
+  while (readers < 2 && waiting.length) {
+    const draft = waiting.shift();
+    readers += 1;
+    readInvoice(draft).finally(function () { readers -= 1; onChange(); startWaiting(); });
+  }
+}
+
+/* Uses the site's existing authenticated, rate-limited reader. A failed
+   arithmetic check gets one second look, matching the financial import. */
+async function requestReading(photo, language, review) {
+  const response = await fetch('/api/read-document', {
+    method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ image: photo.data, mediaType: photo.mediaType, language: language, review: review })
+  });
+  if (response.status === 401 || response.status === 403) { throw new Error('authNeeded'); }
+  if (!response.ok) { throw new Error('failed'); }
+  return response.json();
+}
+async function readInvoice(draft) {
+  try {
+    if (!store.user) { throw new Error('authNeeded'); }
+    const photo = draft.photo || await preparePhotoForUpload(draft.file);
+    draft.photo = photo;
+    draft.preview = photo.preview;
+    const readingLanguage = draft.language;
+    let result = await requestReading(photo, readingLanguage);
+    if (!result.checks.ok) {
+      result = await requestReading(photo, readingLanguage, { previous: result.document, problems: result.checks.problems });
+    }
+    // A language change during a request must not label an English result
+    // as Chinese. Queue a new reading before exposing it for review.
+    if (draft.language !== readingLanguage) { waiting.push(draft); return; }
+    if (!result.document.legible || result.document.kind !== 'purchase' || !result.document.lines.length) { throw new Error('unreadable'); }
+    if (!result.checks.ok) { throw new Error('checkAmounts'); }
+    draft.document = result.document;
+    draft.status = 'ready';
+  } catch (error) {
+    draft.status = 'failed';
+    draft.error = ['authNeeded', 'unreadable', 'checkAmounts'].includes(error.message) ? error.message : 'failed';
+  } finally {
+    // Review needs the small preview and extracted fields, not the original
+    // potentially 20 MB file, for the remainder of this page visit.
+    delete draft.file;
+  }
+}
+
+/* The owner can switch languages while reviews or readings are pending.
+   Compressed photos stay only in this visit's memory for this rereading. */
+export function rereadReadyDrafts(language) {
+  for (const draft of drafts) {
+    if ((draft.status === 'ready' || draft.status === 'reading') && draft.language !== language) {
+      draft.language = language;
+      if (draft.status === 'ready') {
+        draft.status = 'reading';
+        delete draft.document;
+        waiting.push(draft);
+      }
+    }
+  }
+  onChange();
+  startWaiting();
+}
+export function discardDraft(id) {
+  const index = drafts.findIndex(function (draft) { return draft.id === id; });
+  if (index >= 0 && drafts[index].status !== 'reading') { drafts.splice(index, 1); }
+}
diff --git a/frontend/js/stock/forms.js b/frontend/js/stock/forms.js
new file mode 100644
index 0000000000000000000000000000000000000000..f1e7916a63e5497164faff43e6a106f97fb74c3f
--- /dev/null
+++ b/frontend/js/stock/forms.js
@@ -0,0 +1,112 @@
+/* One focused form per action. Counts are absolute; delivery, usage and
+   waste are movements in the item's confirmed unit and location. */
+import { addItem, recordMovement, stockOnHand } from './ledger.js';
+import { store, saveStock } from './storage.js';
+import { drafts } from './files.js';
+import { words } from './language.js';
+import { field, html } from './views.js';
+let refreshed = function () {};
+let report = function () {};
+const dialog = document.getElementById('stock-dialog');
+export function wireForms(onRefresh, onMessage) { refreshed = onRefresh; report = onMessage; }
+export function canChange() { return store.ready && !store.busy && !store.dirty; }
+function id() { return crypto.randomUUID(); }
+function number(form, name) {
+  const value = new FormData(form).get(name);
+  if (typeof value !== 'string' || !value.trim()) { throw new Error('required'); }
+  const quantity = Number(value);
+  if (!Number.isFinite(quantity) || quantity < 0) { throw new Error('quantity'); }
+  return quantity;
+}
+function value(form, name) { return String(new FormData(form).get(name) || '').trim(); }
+function open(title, body) {
+  dialog.innerHTML = `<h2 id="dialog-title">${html(title)}</h2>${body}`;
+  dialog.showModal();
+  dialog.querySelector('[data-cancel]').addEventListener('click', function () { dialog.close(); });
+}
+function buttons(key) {
+  return `<p class="stock-danger" id="form-error" role="alert" hidden></p><div class="stock-actions"><button class="btn" type="button" data-cancel>${words('cancel')}</button><button class="btn primary" type="submit">${words(key)}</button></div>`;
+}
+/* Validation errors stay in the form; persistence errors remain visible after it closes. */
+async function submit(form, operation) {
+  if (!canChange()) { return; }
+  try {
+    const next = operation();
+    for (const button of form.querySelectorAll('button')) { button.disabled = true; }
+    const saved = await saveStock(next);
+    dialog.close();
+    refreshed();
+    if (!saved) { report(store.note); }
+  } catch {
+    const error = document.getElementById('form-error');
+    error.textContent = words('invalid');
+    error.hidden = false;
+  }
+}
+export function showAddItem() {
+  if (!canChange()) { report(store.note); return; }
+  open(words('addItem'), `<form id="manual-item"><p>${words('manualTranslation')}</p>${field('original','original','','text','maxlength="160"')}${field('description','description','','text','maxlength="160"')}<div class="stock-grid">${field('unit','unit','','text','maxlength="40"')}${field('location','location','','text','maxlength="120"')}</div><p class="stock-hint">${words('unitHint')}</p>${field('quantity','onHand','','number','min="0" max="1000000000" step="any"')}${buttons('save')}</form>`);
+  const form = document.getElementById('manual-item');
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+    submit(form, function () {
+      const item = { id: id(), original: value(form,'original'), description: value(form,'description'), unit: value(form,'unit'), location: value(form,'location') };
+      const exists = store.inventory.items.some(function (existing) { return existing.original === item.original && existing.unit === item.unit && existing.location === item.location; });
+      if (exists) { throw new Error('duplicate'); }
+      return recordMovement(addItem(store.inventory,item), { id: id(), itemId: item.id, type: 'count', quantity: number(form,'quantity') });
+    });
+  });
+}
+export function showMovement(itemId, type) {
+  if (!canChange() || !['count','delivery','usage','waste'].includes(type)) { return; }
+  const item = store.inventory.items.find(function (entry) { return entry.id === itemId; });
+  if (!item) { return; }
+  const balance = stockOnHand(store.inventory,itemId);
+  open(words(type), `<p><strong>${html(item.description)}</strong><br>${html(item.original)} · ${html(item.location)} · ${html(item.unit)}</p><p>${words('onHand')}: ${balance === null ? words('unknown') : balance}</p><form id="movement-form">${field('quantity',type === 'count' ? 'onHand':'amount','','number','min="0" max="1000000000" step="any"')}<p class="stock-hint">${words('movementHint')}</p><label class="stock-field">${words('note')}<input name="note" maxlength="300"></label>${buttons('save')}</form>`);
+  const form = document.getElementById('movement-form');
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+    submit(form, function () { return recordMovement(store.inventory, { id:id(), itemId:itemId, type:type, quantity:number(form,'quantity'), note:value(form,'note') }); });
+  });
+}
+/* Every invoice line is editable, with source wording alongside translation.
+   Newly received stock is included in the physical count, never added twice. */
+export function showInvoiceReview(draftId) {
+  if (!canChange()) { return; }
+  const draft = drafts.find(function (entry) { return entry.id === draftId && entry.status === 'ready'; });
+  if (!draft) { return; }
+  let lines = '';
+  draft.document.lines.forEach(function (line,index) {
+    const track = ['cogs','packaging'].includes(line.category);
+    lines += `<fieldset class="stock-review-line"><legend>${html(line.description)}</legend><label><input name="include-${index}" type="checkbox" ${track ? 'checked':''}> ${words('include')}</label><div class="stock-line-fields" ${track ? '':'hidden'}>${field('original-'+index,'original',line.original || line.description,'text','maxlength="160"')}${field('description-'+index,'description',line.description,'text','maxlength="160"')}<p>${words('quantity')}: ${line.quantity === null ? '—':html(line.quantity)} ${html(line.unit || '')}</p><div class="stock-grid">${field('unit-'+index,'unit',line.unit || '','text','maxlength="40"')}${field('location-'+index,'location','','text','maxlength="120"')}</div>${field('count-'+index,'onHand','','number','min="0" max="1000000000" step="any"')}</div></fieldset>`;
+  });
+  open(words('reviewTitle'), `<p>${html(draft.name)} · ${html(draft.document.supplier || '')}</p><img class="stock-preview" src="${draft.preview}" alt="${html(draft.name)}"><p>${words('countHint')}</p><form id="invoice-stock">${lines}${buttons('saveReview')}</form>`);
+  const form = document.getElementById('invoice-stock');
+  function updateRequired() {
+    for (const fieldset of form.querySelectorAll('fieldset')) {
+      const included = fieldset.querySelector('input[type="checkbox"]').checked;
+      fieldset.querySelector('.stock-line-fields').hidden = !included;
+      for (const input of fieldset.querySelectorAll('.stock-line-fields input')) { input.disabled = !included; }
+    }
+  }
+  updateRequired();
+  form.addEventListener('change',updateRequired);
+  form.addEventListener('submit',function (event) {
+    event.preventDefault();
+    submit(form,function () {
+      let next = store.inventory;
+      let count = 0;
+      draft.document.lines.forEach(function (line,index) {
+        if (!form.elements['include-'+index].checked) { return; }
+        const item = { id:id(), original:value(form,'original-'+index), description:value(form,'description-'+index), unit:value(form,'unit-'+index), location:value(form,'location-'+index) };
+        const existing = next.items.find(function (entry) { return entry.original === item.original && entry.unit === item.unit && entry.location === item.location; });
+        let itemId = item.id;
+        if (existing) { itemId = existing.id; } else { next = addItem(next,item); }
+        next = recordMovement(next, { id:id(), itemId:itemId, type:'count', quantity:number(form,'count-'+index), note:'source:'+draft.hash });
+        count += 1;
+      });
+      if (!count) { throw new Error('no items'); }
+      return next;
+    });
+  });
+}
