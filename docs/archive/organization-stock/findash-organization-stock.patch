diff --git a/frontend/js/stock/ledger.js b/frontend/js/stock/ledger.js
new file mode 100644
index 0000000000000000000000000000000000000000..9b7f693fd6a0207c040baeef33aea3394014a85e
--- /dev/null
+++ b/frontend/js/stock/ledger.js
@@ -0,0 +1,181 @@
+/* Confirmed physical stock, separate from purchases and financial totals.
+   Each item has its own explicit unit and location; units are never guessed
+   or converted. A count establishes stock before deliveries, usage or waste. */
+
+const MAXIMUM_ITEMS = 2000;
+const MAXIMUM_MOVEMENTS = 10000;
+const MOVEMENT_TYPES = ["count", "delivery", "usage", "waste"];
+
+/* A new ledger has no assumed stock balances. */
+export function emptyInventory() {
+  return { version: 1, items: [], movements: [] };
+}
+
+/* Refuse extra fields so an account cannot become unbounded file storage. */
+function checkKeys(value, allowed, label) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new Error(label + " must be an object");
+  }
+  for (const key of Object.keys(value)) {
+    if (!allowed.includes(key)) {
+      throw new Error("Unexpected " + label + " field: " + key);
+    }
+  }
+}
+
+/* Every visible item field is explicit and bounded. */
+function checkText(value, maximum, label) {
+  if (typeof value !== "string" || !value.trim() || value.length > maximum) {
+    throw new Error(label + " must be text, between 1 and " + maximum + " characters");
+  }
+}
+
+/* Validate an item without changing the supplier's original wording. */
+function checkItem(item) {
+  checkKeys(item, ["id", "original", "description", "unit", "location"], "item");
+  checkText(item.id, 80, "Item id");
+  checkText(item.original, 160, "Original description");
+  checkText(item.description, 160, "Description");
+  checkText(item.unit, 40, "Unit");
+  checkText(item.location, 120, "Location");
+}
+
+/* An event is append-only; at is its recorded time, not a request to reorder history. */
+function checkMovement(movement) {
+  checkKeys(movement, ["id", "itemId", "type", "quantity", "at", "note"], "movement");
+  checkText(movement.id, 80, "Movement id");
+  checkText(movement.itemId, 80, "Movement item id");
+  if (!MOVEMENT_TYPES.includes(movement.type)) {
+    throw new Error("Movement type must be count, delivery, usage or waste");
+  }
+  if (typeof movement.quantity !== "number" || !Number.isFinite(movement.quantity) ||
+      movement.quantity < 0 || movement.quantity > 1_000_000_000) {
+    throw new Error("Quantity must be a finite number between 0 and 1000000000");
+  }
+  if (typeof movement.at !== "string" || movement.at.length > 40 ||
+      !/^\d{4}-\d{2}-\d{2}T/.test(movement.at) || !Number.isFinite(Date.parse(movement.at))) {
+    throw new Error("Movement time must be an ISO date and time");
+  }
+  if (movement.note !== undefined && (typeof movement.note !== "string" || movement.note.length > 300)) {
+    throw new Error("Movement note must be text of at most 300 characters");
+  }
+}
+
+/* Read a number's decimal spelling as whole digits and decimal places.
+   This keeps 0.3 - 0.1 - 0.2 at zero without permitting tiny overdraws. */
+function decimalParts(value) {
+  const [coefficient, exponent = "0"] = String(value).split("e");
+  const [whole, fraction = ""] = coefficient.split(".");
+  let digits = BigInt(whole + fraction);
+  let places = fraction.length - Number(exponent);
+  if (places < 0) {
+    digits *= 10n ** BigInt(-places);
+    places = 0;
+  }
+  return { digits, places };
+}
+
+/* Add or subtract the stated decimal quantities, with no unit conversion. */
+function adjustedQuantity(balance, quantity, subtract) {
+  const first = decimalParts(balance);
+  const second = decimalParts(quantity);
+  const places = Math.max(first.places, second.places);
+  const balanceDigits = first.digits * 10n ** BigInt(places - first.places);
+  const quantityDigits = second.digits * 10n ** BigInt(places - second.places);
+  const next = subtract ? balanceDigits - quantityDigits : balanceDigits + quantityDigits;
+  if (next < 0n) {
+    throw new Error("This movement would make stock negative");
+  }
+  return Number(String(next) + "e-" + places);
+}
+
+/* Replay physical changes; purchase quantities alone never initialize stock. */
+function applyMovement(balance, movement) {
+  if (movement.type === "count") {
+    return movement.quantity;
+  }
+  if (balance === null) {
+    throw new Error("Count what is on the shelf before recording deliveries, usage or waste");
+  }
+  const subtract = movement.type === "usage" || movement.type === "waste";
+  const next = adjustedQuantity(balance, movement.quantity, subtract);
+  if (!Number.isFinite(next) || next < 0 || next > 1_000_000_000) {
+    throw new Error("This movement would make stock negative or too large");
+  }
+  return next;
+}
+
+/* Validate the entire history, including duplicate ids and negative balances. */
+function checkedBalances(inventory) {
+  checkKeys(inventory, ["version", "items", "movements"], "inventory");
+  if (inventory.version !== 1 || !Array.isArray(inventory.items) || !Array.isArray(inventory.movements)) {
+    throw new Error("Inventory needs version 1, items and movements");
+  }
+  if (inventory.items.length > MAXIMUM_ITEMS || inventory.movements.length > MAXIMUM_MOVEMENTS) {
+    throw new Error("Inventory exceeds its item or movement limit");
+  }
+  const balances = new Map();
+  for (const item of inventory.items) {
+    checkItem(item);
+    if (balances.has(item.id)) {
+      throw new Error("Duplicate item id");
+    }
+    balances.set(item.id, null);
+  }
+  const eventIds = new Set();
+  for (const movement of inventory.movements) {
+    checkMovement(movement);
+    if (!balances.has(movement.itemId)) {
+      throw new Error("Movement refers to an unknown item");
+    }
+    if (eventIds.has(movement.id)) {
+      throw new Error("Duplicate movement id");
+    }
+    eventIds.add(movement.id);
+    balances.set(movement.itemId, applyMovement(balances.get(movement.itemId), movement));
+  }
+  return balances;
+}
+
+/* Public validation keeps the original record intact. */
+export function validateInventory(inventory) {
+  checkedBalances(inventory);
+  return inventory;
+}
+
+/* A list view asks for all balances in one pass, rather than replaying the
+   same history separately for every item on the page. */
+export function stockBalances(inventory) {
+  return checkedBalances(inventory);
+}
+
+/* Add a reviewed item; its shelf quantity remains unknown until counted. */
+export function addItem(inventory, input) {
+  validateInventory(inventory);
+  const item = { ...input };
+  checkItem(item);
+  const next = { version: 1, items: [...inventory.items, item], movements: [...inventory.movements] };
+  validateInventory(next);
+  return next;
+}
+
+/* Add one confirmed physical change without mutating the previous state. */
+export function recordMovement(inventory, input) {
+  validateInventory(inventory);
+  const movement = { ...input };
+  if (movement.at === undefined) {
+    movement.at = new Date().toISOString();
+  }
+  const next = { version: 1, items: [...inventory.items], movements: [...inventory.movements, movement] };
+  validateInventory(next);
+  return next;
+}
+
+/* A null balance asks the owner to count; zero means a confirmed empty shelf. */
+export function stockOnHand(inventory, itemId) {
+  const balances = stockBalances(inventory);
+  if (!balances.has(itemId)) {
+    throw new Error("Unknown item");
+  }
+  return balances.get(itemId);
+}
diff --git a/frontend/js/stock/main.js b/frontend/js/stock/main.js
new file mode 100644
index 0000000000000000000000000000000000000000..e0898a074b6cea4b315c6e6bcba8694049ac1c0c
--- /dev/null
+++ b/frontend/js/stock/main.js
@@ -0,0 +1,132 @@
+/* Daily work starts here: add records, review, count shelves, then record
+   deliveries/usage/waste. Finance remains a separate destination. */
+import { emptyInventory } from './ledger.js';
+import { words, loadLanguage, setLanguage, currentLanguage } from './language.js';
+import { store, loadStock, saveStock, downloadBackup, parseInventory, clearGuestStock } from './storage.js';
+import { drafts, addFiles, onFilesChanged, discardDraft, rereadReadyDrafts } from './files.js';
+import { filesHtml, reviewHtml, itemsHtml, settingsHtml, printHtml } from './views.js';
+import { wireForms, showAddItem, showMovement, showInvoiceReview, canChange } from './forms.js';
+const panel = document.getElementById('stock-panel');
+
+/* User-facing errors use localized messages, not raw provider diagnostics. */
+function message(key) {
+  const element = document.getElementById('stock-message');
+  element.textContent = words(key);
+  element.hidden = false;
+}
+function view() {
+  const requested = window.location.hash.slice(1);
+  return ['files','review','items','settings'].includes(requested) ? requested : 'files';
+}
+function render() {
+  const current = view();
+  document.getElementById('view-title').textContent = words(current + 'Title');
+  for (const link of document.querySelectorAll('[data-view]')) {
+    if (link.dataset.view === current) { link.setAttribute('aria-current','page'); } else { link.removeAttribute('aria-current'); }
+  }
+  document.getElementById('review-count').textContent = drafts.filter(function (draft) { return draft.status === 'ready' || draft.status === 'reading'; }).length;
+  document.getElementById('add-item').disabled = !canChange();
+  document.getElementById('stock-storage').textContent = words(store.note || 'loading');
+  if (current === 'items') { panel.innerHTML = itemsHtml(); }
+  else if (current === 'review') { panel.innerHTML = reviewHtml(); }
+  else if (current === 'settings') { panel.innerHTML = settingsHtml(); }
+  else { panel.innerHTML = filesHtml(); }
+  if (store.dirty) {
+    const button = document.createElement('button');
+    button.className = 'btn';
+    button.id = 'retry-stock';
+    button.textContent = words('sync');
+    panel.prepend(button);
+  }
+  const drop = document.getElementById('stock-drop');
+  if (drop) { wireDrop(drop); }
+}
+function discardSavedDrafts() {
+  if (store.dirty) { return; }
+  for (const draft of [...drafts]) {
+    if (draft.hash && store.inventory.movements.some(function (movement) { return movement.note === 'source:' + draft.hash; })) { discardDraft(draft.id); }
+  }
+}
+function saved() {
+  discardSavedDrafts();
+  window.location.hash = 'items';
+  render();
+}
+async function handleFiles(files) {
+  if (!canChange()) { message(store.note); return; }
+  try { await addFiles(files); } catch { message('failed'); }
+}
+/* Desktop drops and phone/desktop file pickers feed the same queue. */
+function wireDrop(drop) {
+  drop.addEventListener('dragover',function (event) { event.preventDefault(); drop.classList.add('over'); });
+  drop.addEventListener('dragleave',function () { drop.classList.remove('over'); });
+  drop.addEventListener('drop',function (event) {
+    event.preventDefault();
+    drop.classList.remove('over');
+    handleFiles([...event.dataTransfer.files]);
+  });
+}
+function printCountSheet() {
+  const previous = panel.innerHTML;
+  panel.innerHTML = printHtml();
+  function restore() { panel.innerHTML = previous; render(); }
+  window.addEventListener('afterprint', restore, { once:true });
+  window.print();
+}
+/* Delegation keeps controls working after a file finishes in the background. */
+async function handleClick(event) {
+  const button = event.target.closest('button');
+  if (!button) { return; }
+  if (button.id === 'choose-photos') { document.getElementById('stock-files').click(); }
+  else if (button.dataset.review) { showInvoiceReview(button.dataset.review); }
+  else if (button.dataset.discard) { discardDraft(button.dataset.discard); render(); }
+  else if (button.dataset.movement) { showMovement(button.dataset.item,button.dataset.movement); }
+  else if (button.id === 'backup-stock') { downloadBackup(); }
+  else if (button.id === 'restore-stock') { document.getElementById('restore-file').click(); }
+  else if (button.id === 'clear-stock') {
+    if (store.user && canChange() && window.confirm(words('clearAccountQuestion'))) { await saveStock(emptyInventory()); }
+    else if (!store.user) { clearGuestStock(); }
+    render();
+  }
+  else if (button.id === 'print-stock') { printCountSheet(); }
+  else if (button.id === 'retry-stock') { button.disabled = true; await saveStock(store.inventory); discardSavedDrafts(); render(); }
+}
+async function handleChange(event) {
+  if (event.target.id === 'stock-files') { handleFiles([...event.target.files]); }
+  if (event.target.id === 'restore-file' && event.target.files.length && canChange()) {
+    try {
+      const file = event.target.files[0];
+      if (file.size > 1_000_000) { throw new Error('size'); }
+      const restored = parseInventory(await file.text());
+      if (window.confirm(words('restoreQuestion'))) { await saveStock(restored); render(); }
+    } catch { message('invalid'); }
+  }
+}
+async function start() {
+  setLanguage(loadLanguage());
+  wireForms(saved,message);
+  onFilesChanged(render);
+  window.addEventListener('hashchange',function () { document.getElementById('stock-message').hidden = true; render(); });
+  document.getElementById('add-item').addEventListener('click',showAddItem);
+  document.getElementById('stock-language').addEventListener('change',function (event) {
+    setLanguage(event.target.value);
+    rereadReadyDrafts(currentLanguage());
+    render();
+  });
+  panel.addEventListener('click',handleClick);
+  panel.addEventListener('change',handleChange);
+  panel.addEventListener('input',function (event) {
+    if (event.target.id !== 'stock-search') { return; }
+    const query = event.target.value.toLocaleLowerCase();
+    for (const row of panel.querySelectorAll('[data-stock-row]')) { row.hidden = !row.textContent.toLocaleLowerCase().includes(query); }
+  });
+  window.addEventListener('beforeunload',function (event) {
+    const pending = drafts.some(function (draft) { return draft.status === 'ready' || draft.status === 'reading'; });
+    if (store.dirty || pending) { event.preventDefault(); event.returnValue = words('pendingLeave'); }
+  });
+  render();
+  await loadStock();
+  if (store.user && store.user.email) { document.getElementById('stock-account').textContent = store.user.email; }
+  render();
+}
+start();
diff --git a/frontend/js/stock/storage.js b/frontend/js/stock/storage.js
new file mode 100644
index 0000000000000000000000000000000000000000..05349e429eb2b9712a1c8793d4f47254a783c66e
--- /dev/null
+++ b/frontend/js/stock/storage.js
@@ -0,0 +1,97 @@
+/* Guest stock stays on this device. Account stock uses a separate RLS table,
+   never the P&L document, so saving either cannot erase the other. */
+import { emptyInventory, validateInventory } from './ledger.js';
+import { words } from './language.js';
+const GUEST_KEY = 'findash-stock-guest-v1';
+export const store = { inventory: emptyInventory(), user: null, revision: 0, ready: false, dirty: false, busy: false, note: '' };
+
+/* Refuses damaged backups rather than silently dropping their records. */
+export function parseInventory(text) {
+  const inventory = JSON.parse(text);
+  validateInventory(inventory);
+  return inventory;
+}
+
+/* Only guest data is written to local storage; signed-in records stay in memory. */
+export async function loadStock() {
+  try {
+    const capabilities = await fetch('/api/capabilities');
+    if (!capabilities.ok) { throw new Error('account'); }
+    const options = await capabilities.json();
+    if (options.accounts) {
+      const response = await fetch('/api/auth?action=me', { credentials: 'same-origin' });
+      if (!response.ok) { throw new Error('account'); }
+      const result = await response.json();
+      store.user = result.user;
+    }
+    if (store.user && store.user.email) {
+      const response = await fetch('/api/inventory', {
+        credentials: 'same-origin', cache: 'no-store', headers: { 'X-FinDash-Owner': store.user.email }
+      });
+      if (!response.ok) { throw new Error('account'); }
+      const result = await response.json();
+      validateInventory(result.inventory);
+      store.inventory = result.inventory;
+      store.revision = result.revision;
+      store.note = 'accountSaved';
+    } else {
+      const saved = localStorage.getItem(GUEST_KEY);
+      if (saved) { store.inventory = parseInventory(saved); }
+      store.note = 'guest';
+    }
+    store.ready = true;
+  } catch {
+    store.note = 'accountFailed';
+    store.ready = false;
+  }
+}
+
+/* A failed write leaves the new record in memory and clearly marked unsaved. */
+export async function saveStock(inventory) {
+  validateInventory(inventory);
+  if (!store.ready || store.busy) { return false; }
+  store.inventory = inventory;
+  store.dirty = true;
+  store.busy = true;
+  try {
+    if (store.user && store.user.email) {
+      const response = await fetch('/api/inventory', {
+        method: 'PUT', credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', 'X-FinDash-Owner': store.user.email },
+        body: JSON.stringify({ inventory: inventory, revision: store.revision })
+      });
+      if (response.status === 409) { store.note = 'conflict'; return false; }
+      if (response.status === 401) { store.note = 'sessionExpired'; return false; }
+      if (!response.ok) { throw new Error('save'); }
+      store.revision = (await response.json()).revision;
+      store.note = 'accountSaved';
+    } else {
+      localStorage.setItem(GUEST_KEY, JSON.stringify(inventory));
+      store.note = 'guest';
+    }
+    store.dirty = false;
+    return true;
+  } catch {
+    store.note = store.user ? 'unsaved' : 'storageBlocked';
+    return false;
+  } finally {
+    store.busy = false;
+  }
+}
+
+/* Exports data only when the owner presses the backup button. */
+export function downloadBackup() {
+  const blob = new Blob([JSON.stringify(store.inventory, null, 2)], { type: 'application/json' });
+  const address = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = address;
+  link.download = 'findash-stock-' + new Date().toISOString().slice(0, 10) + '.json';
+  link.click();
+  URL.revokeObjectURL(address);
+}
+export function clearGuestStock() {
+  if (store.user || !window.confirm(words('clearQuestion'))) { return; }
+  localStorage.removeItem(GUEST_KEY);
+  store.inventory = emptyInventory();
+  store.dirty = false;
+}
diff --git a/frontend/js/stock/views.js b/frontend/js/stock/views.js
new file mode 100644
index 0000000000000000000000000000000000000000..34011f7ffe31620eaced693b2f2fe6840945acb2
